{
  "title": "tab to hyper when held",
  "rules": [
    {
      "description": "Map Tab to Hyper when held",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_command",
              "modifiers": [
                "left_option"
              ]
            }
          ],
          "to_if_alone": [
            {
              "key_code": "tab"
            }
          ],
          "conditions": [
            {
              "type": "unless",
              "conditions": [
                {
                  "type": "frontmost_application_if",
                  "bundle_identifiers": [
                    "^com\\.apple\\.Terminal$"
                  ]
                },
                {
                  "type": "variable_if",
                  "name": "vim_mode",
                  "value": 1
                }
              ]
            },
            {
              "type": "unless",
              "bundle_identifiers": []
            },
            {
              "type": "key_down_if",
              "key_codes": [
                "h",
                "j",
                "k",
                "l"
              ]
            }
          ]
        }
      ]
    }
  ]
}